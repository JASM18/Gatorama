<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Gatorama" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/Gatorama" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/Gatorama" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<!-- type 0 es aplicacion de ventana y type 1 de consola. Release va en 0
				     para que al abrir el juego no salga una ventana negra atras. Debug se
				     queda en 1 a proposito: ahi si queremos ver los mensajes de raylib. -->
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<!-- -s quita los simbolos de depuracion: el .exe pesa menos.

					     -static es el que hace que el juego se pueda llevar a otra
					     computadora. Sin el, el .exe pide libgcc_s_seh-1.dll y
					     libstdc++-6.dll, que existen en la maquina de quien programa
					     porque las trae MinGW, pero NO en una Windows recien instalada:
					     alla el juego no abre y solo sale un cuadro de error. Con -static
					     esas bibliotecas se meten dentro del .exe. Pesa unos 2.5 MB mas y
					     ya no depende de nada que no traiga Windows. -->
					<Add option="-s" />
					<Add option="-static" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
			<Add option="-DPLATFORM_DESKTOP" />
			<Add directory="libs/raylib/include" />
		</Compiler>
		<Linker>
			<Add library="raylib" />
			<Add library="opengl32" />
			<Add library="gdi32" />
			<Add library="winmm" />
			<Add directory="libs/raylib/lib" />
		</Linker>
		<Unit filename="Aleatorio.cpp" />
		<Unit filename="Aleatorio.hpp" />
		<Unit filename="Carta.cpp" />
		<Unit filename="Carta.hpp" />
		<Unit filename="Dibujo.cpp" />
		<Unit filename="Dibujo.hpp" />
		<Unit filename="Dificultad.cpp" />
		<Unit filename="Dificultad.hpp" />
		<Unit filename="Menu.cpp" />
		<Unit filename="Menu.hpp" />
		<Unit filename="Tablero.cpp" />
		<Unit filename="Tablero.hpp" />
		<Unit filename="Tema.hpp" />
		<Unit filename="VistaTablero.cpp" />
		<Unit filename="VistaTablero.hpp" />
		<Unit filename="Boton.cpp" />
		<Unit filename="Boton.hpp" />
		<Unit filename="ConfigPartida.cpp" />
		<Unit filename="ConfigPartida.hpp" />
		<Unit filename="Configuracion.cpp" />
		<Unit filename="Configuracion.hpp" />
		<Unit filename="Escena.hpp" />
		<Unit filename="Juego.cpp" />
		<Unit filename="Juego.hpp" />
		<Unit filename="Pausa.cpp" />
		<Unit filename="Pausa.hpp" />
		<Unit filename="Audio.cpp" />
		<Unit filename="Audio.hpp" />
		<Unit filename="Creditos.cpp" />
		<Unit filename="Creditos.hpp" />
		<Unit filename="Instrucciones.cpp" />
		<Unit filename="Instrucciones.hpp" />
		<Unit filename="Partida.cpp" />
		<Unit filename="Partida.hpp" />
		<Unit filename="Monticulo.cpp" />
		<Unit filename="Monticulo.hpp" />
		<Unit filename="Puntaje.cpp" />
		<Unit filename="Puntaje.hpp" />
		<Unit filename="Puntajes.cpp" />
		<Unit filename="Puntajes.hpp" />
		<Unit filename="TablaPuntajes.cpp" />
		<Unit filename="TablaPuntajes.hpp" />
		<Unit filename="Opciones.cpp" />
		<Unit filename="Opciones.hpp" />
		<Unit filename="Resultados.cpp" />
		<Unit filename="Resultados.hpp" />
		<Unit filename="main.cpp" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
